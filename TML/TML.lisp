#Base for all lisp defined elements, 
#default working as a stacker

(defclass ElementBase ()
    (parent (new-updated-info))

    (set-parent-info (new-parent)
        (set-parent-info :parent this new-parent)
    )
    (set-children (children)
        null
    )
    (set-focus (value)
        null
    )
    (get-cursor-info ()
        (cursor-info)
    )
    (prefered-dims (dimensions)
        (dims 1 1)
    )
    (updated ()
        (updated :parent this)
    )
    (handle-input (input)
        null
    )
    (write (view redraw)
        null
    )
    (set-updated (is-updated)
        (set-updated :parent this is-updated)
    )
)


(defclass TMLElement (ElementBase)
    (attributes (dict))
    (children (list))
    (expr-children (list))
    (input null)

    (set-children (children)
        (setl :children this children)
        (map _(set-parent-info _ :parent this) :children this)
    )
    (add-child (child)
        (set-parent-info child :parent this)
        (append :children this child)
    )
    (constructor (children)
        (setl :children this children)
    )
    (handle-input (input)
        (if (not (eq :input this null))
            (return (handle-input :input this input))
        )
        false
    )
    (get-cursor-info ()
        (if (not (eq :input this null))
            (return (get-cursor-info :input this))
        )
        (cursor-info )
    )
    (prefered-dims (dimensions)
        (setl prefered-width (max (map _(width (prefered-dims _ dimensions)) :children this)))
        (if (eq (type prefered-width) null_t) (setl prefered-width (width dimensions)))
        (setl prefered-height (height dimensions))
        (if (> (len :children this) 0)
            (setl prefered-height (foldl (map _(height (prefered-dims _ dimensions)) :children this) plus))

        )
        (dims prefered-width prefered-height)
    )

    (write (view redraw)
        (set-updated this false)
        (setl view-dims (dims view))
        (setl height-offset 0)
        (setl current-offset (+ (len :children this) (minus 0 1)))
        (while (>= current-offset 0)
            (setl child ;current-offset :children this)
            (setl dimensions (prefered-dims child view-dims))
            (setl dimensions (dims (cond (< (width dimensions) 0) 1 (width dimensions) )  (cond (< (height dimensions) 0) 1 (height dimensions))  ))
            (if (|| redraw (updated child))
                (write child (sub-view view height-offset 0) redraw)
            )
            (incr height-offset (height dimensions))
            (incr current-offset (minus 0 1))
        )
    )

    (set-focus (focused)
        (if (eq (len :children this) 1)
            (set-focus :0 :children this focused)
        )
    )

    (update ()
        (doit child :expr-children this
            (update child)
        )
        (set-updated this true)
    )
)



(defclass Attribute ()
    (name "")
    (value null)
    (mandatory true)
    (is-parameter-value true)
)
(defclass Header ()
    (name 'null)
    (attributes (dict))
    (field-name null)
    (assignments (list))
    (closed false)
)

(defclass Element ()
    (header (Header))
    (children (list))
    (extra-fields (list))
)
